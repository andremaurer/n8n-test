// Life-Optimization-Planner — local single-user data model (SQLite)
// Privacy-first: all data stays in a local SQLite file by default.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A person whose life/profile we analyse: you, or a family/team member.
model Person {
  id         String   @id @default(cuid())
  name       String
  role       String   @default("SELF") // SELF | FAMILY | TEAM | OTHER
  // Birth data (editable in the UI; drives astrology, human design, numerology)
  birthDate  String? // ISO date "YYYY-MM-DD"
  birthTime  String? // "HH:MM" (local clock time at birth place); null = unknown
  birthPlace String?
  birthLat   Float?
  birthLng   Float?
  timezone   String? // IANA tz, e.g. "Europe/Zurich"
  gender     String?
  notes      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assessments       AssessmentResult[]
  goals             Goal[]
  lifePhases        LifePhase[]
  journalEntries    JournalEntry[]
  habits            Habit[]
  finance           FinanceProfile?
  memberships       ConstellationMember[]
  businessIdeas     BusinessIdea[]
  wheelCheckins     WheelCheckin[]
  decisions         Decision[]
  skills            Skill[]
  ikigai            Ikigai?
  accounts          Account[]
  revenueStreams    RevenueStream[]
  experiments       Experiment[]
  todos             Todo[]
  timeEntries       TimeEntry[]
}

// Todo with goal alignment + AI review verdict.
model Todo {
  id           String   @id @default(cuid())
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  title        String
  goalId       String?  // optional link to a Goal
  goal         Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  priority     String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  effortMin    Int      @default(30)        // estimated minutes
  due          String?  // ISO date
  status       String   @default("OPEN")    // OPEN | DOING | DONE | DROPPED
  // AI review
  alignment    String?  // ALIGNED | NEUTRAL | BUSYWORK
  aiNote       String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  completedAt  String?

  @@index([personId, status])
}

// A time entry — from calendar (ICS) or the 15-min Mac activity tracker.
model TimeEntry {
  id          String   @id @default(cuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  start       String   // ISO datetime
  end         String?  // ISO datetime (null = instantaneous sample)
  minutes     Int      @default(15)
  activity    String   // free text from tracker / event title
  category    String?  // BUSINESS | ADMIN | LEARNING | FAMILY | HEALTH | REST | OTHER
  goalId      String?
  source      String   @default("MANUAL") // MANUAL | TRACKER | CALENDAR
  externalId  String?  // dedup key (ICS UID, tracker sample id)
  createdAt   DateTime @default(now())

  @@index([personId, start])
  @@unique([personId, source, externalId])
}

// Market-validation experiment — test an offer before investing heavily.
// "Riskiest assumption test": define what you believe, how you'll test it cheaply,
// the success threshold, and the result.
model Experiment {
  id           String   @id @default(cuid())
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  title        String   // e.g. "KMU zahlen 3'000 CHF für AI-Audit"
  hypothesis   String   @default("") // what you believe is true
  method       String   @default("") // how you test it (calls, landing page, BNI pitch)
  riskiest     String   @default("") // the riskiest assumption
  metric       String   @default("") // what you measure (e.g. "zahlende Zusagen")
  threshold    Float    @default(0) // success threshold for the metric
  result       Float?   // actual measured value
  cost         Float    @default(0) // CHF spent on the test
  status       String   @default("PLANNED") // PLANNED | RUNNING | VALIDATED | INVALIDATED
  notes        String?
  createdAt    DateTime @default(now())

  @@index([personId])
}

// Wheel of Life — 8 life areas scored 1-10, recurring check-in.
model WheelCheckin {
  id            String   @id @default(cuid())
  personId      String
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  date          String
  career        Int      @default(5)
  finance       Int      @default(5)
  health        Int      @default(5)
  relationships Int      @default(5)
  family        Int      @default(5)
  growth        Int      @default(5)
  fun           Int      @default(5)
  spirituality  Int      @default(5)
  createdAt     DateTime @default(now())

  @@index([personId])
}

// Decision assistant — weighted pro/con snapshot.
model Decision {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  title     String
  optionA   String   @default("Option A")
  optionB   String   @default("Option B")
  factors   String   @default("[]")
  decision  String?
  createdAt DateTime @default(now())

  @@index([personId])
}

// Skill inventory → monetization matrix.
model Skill {
  id           String   @id @default(cuid())
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  name         String
  proficiency  Int      @default(3)
  enjoyment    Int      @default(3)
  marketDemand Int      @default(3)
  createdAt    DateTime @default(now())

  @@index([personId])
}

// Ikigai — four overlapping circles (one per person).
model Ikigai {
  id         String   @id @default(cuid())
  personId   String   @unique
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  love       String   @default("")
  goodAt     String   @default("")
  paidFor    String   @default("")
  worldNeeds String   @default("")
  updatedAt  DateTime @updatedAt
}

// A financial account / position. Multiple per person; summed into net worth.
// Covers bank accounts, P2P lending (Debitum, Mintos), pillar 3a / pension, etc.
model Account {
  id          String   @id @default(cuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  name        String
  institution String?  // e.g. "Mintos", "ZKB", "VIAC 3a"
  kind        String   @default("BANK") // BANK | CASH | P2P | PILLAR3A | PILLAR2 | INVEST | CRYPTO | DEBT | OTHER
  currency    String   @default("CHF")
  balance     Float    @default(0)
  // Optional yield assumption for projections (annual, e.g. 0.11 for Mintos).
  expectedYield Float  @default(0)
  // Liquidity: can this be drawn on before retirement?
  liquid      Boolean  @default(true)
  notes       String?
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([personId])
}

// An income stream (active or passive). Drives the path to 15-20k CHF/month.
model RevenueStream {
  id            String   @id @default(cuid())
  personId      String
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  name          String   // "Foto/Video Aufträge", "AI-Implementierung Retainer", ...
  kind          String   @default("ACTIVE") // ACTIVE | PASSIVE | PORTFOLIO
  monthlyNow    Float    @default(0) // current CHF/month
  monthlyTarget Float    @default(0) // target CHF/month
  status        String   @default("BUILDING") // IDEA | BUILDING | LIVE | SCALING
  notes         String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([personId])
}

// Result of a psychometric questionnaire (Big Five, RIASEC, Enneagram, ...).
model AssessmentResult {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  type      String // BIG_FIVE | HEXACO | RIASEC | ENNEAGRAM | DISC | VIA | VALUES
  scores    String // JSON: { dimension: number, ... }
  answers   String? // JSON: raw item answers
  createdAt DateTime @default(now())

  @@index([personId, type])
}

// Goals across horizons (1 / 3 / 10 years) and life areas.
model Goal {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  horizon   String   @default("ONE_YEAR") // ONE_YEAR | THREE_YEARS | TEN_YEARS | LIFE
  area      String   @default("GENERAL")  // CAREER | FINANCE | FAMILY | HEALTH | GROWTH | GENERAL
  text      String
  status    String   @default("OPEN") // OPEN | IN_PROGRESS | DONE | DROPPED
  createdAt DateTime @default(now())
  todos     Todo[]

  @@index([personId])
}

// A life phase / chapter with priorities and open decisions.
model LifePhase {
  id         String   @id @default(cuid())
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  title      String
  area       String   @default("GENERAL")
  startDate  String?
  endDate    String?
  status     String   @default("ACTIVE") // PLANNED | ACTIVE | CLOSED
  priorities String? // JSON array of strings
  notes      String?
  createdAt  DateTime @default(now())

  @@index([personId])
}

// Reflection journal (also feeds the "current, specific to me" layer).
model JournalEntry {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  date      String // ISO date
  mood      Int? // 1-10
  text      String
  createdAt DateTime @default(now())

  @@index([personId])
}

// Habits — the evidence-based translation of "manifestation"/Geldanziehung.
model Habit {
  id        String     @id @default(cuid())
  personId  String
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  title     String
  cadence   String     @default("DAILY") // DAILY | WEEKLY
  category  String     @default("MINDSET") // MINDSET | FINANCE | HEALTH | GROWTH
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  logs      HabitLog[]

  @@index([personId])
}

model HabitLog {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    String // ISO date
  done    Boolean @default(true)

  @@unique([habitId, date])
}

// Financial profile — drives the FIRE / freedom calculator.
model FinanceProfile {
  id                  String  @id @default(cuid())
  personId            String  @unique
  person              Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  currency            String  @default("CHF")
  monthlyIncomeActive  Float  @default(0)
  monthlyIncomePassive Float  @default(0)
  monthlyExpenses      Float  @default(0)
  netWorth             Float  @default(0)
  debt                 Float  @default(0)
  // FIRE assumptions
  withdrawalRate       Float  @default(0.04) // 4% rule
  expectedReturn       Float  @default(0.05) // real annual return
  targetMonthlySpend   Float  @default(0)    // desired spend in freedom (0 = use expenses)
  pillar2              Float  @default(0)    // CH: Pensionskasse balance
  pillar3a             Float  @default(0)    // CH: Säule 3a balance
  wealthTaxRate        Float  @default(0.005) // CH: cantonal wealth tax (approx)
  // Income-freedom + household strategy (CH)
  targetMonthlyPayout  Float  @default(0)     // short-term goal, e.g. 15-20k CHF/month
  companyProfit        Float  @default(0)     // annual distributable profit
  ownerSalary          Float  @default(0)     // gross owner salary / year
  partnerSalary        Float  @default(0)     // gross partner salary / year
  marginalTaxRate      Float  @default(0.25)  // household marginal income tax
  updatedAt            DateTime @updatedAt
}

// Candidate business fields, scored against fit + market.
model BusinessIdea {
  id           String   @id @default(cuid())
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  // 1-5 scores
  fitStrengths  Int     @default(3) // matches my strengths
  fitValues     Int     @default(3) // matches my values/personality
  marketSize    Int     @default(3)
  scalability   Int     @default(3)
  timeToCash    Int     @default(3) // 5 = fast
  capitalNeed   Int     @default(3) // 5 = low capital need (better)
  passiveness   Int     @default(3) // 5 = can become passive
  notes        String?
  createdAt    DateTime @default(now())

  @@index([personId])
}

// A family or team constellation.
model Constellation {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("FAMILY") // FAMILY | TEAM
  notes     String?
  createdAt DateTime @default(now())
  members   ConstellationMember[]
}

model ConstellationMember {
  id              String        @id @default(cuid())
  constellationId String
  constellation   Constellation @relation(fields: [constellationId], references: [id], onDelete: Cascade)
  personId        String
  person          Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  roleLabel       String? // e.g. "Vater", "CTO", "Mentor"

  @@unique([constellationId, personId])
}

// App-level settings (singleton row id = "app").
model AppSettings {
  id            String  @id @default("app")
  selfPersonId  String?
  displayName   String?
  updatedAt     DateTime @updatedAt
}
