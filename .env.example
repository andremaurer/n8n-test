# Local SQLite database (single-user, privacy-first — data stays on your machine)
DATABASE_URL="file:./dev.db"

# Optional: enables the AI synthesis layer (Claude). Without it, the app falls
# back to a deterministic, rule-based interpretation so everything still works.
# ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"
