# ====== VoiceClaude Konfiguration ======
# Kopiere diese Datei zu ".env" und passe die Werte an:  cp .env.example .env

# Passwort fuer den Login (BITTE AENDERN!)
APP_PASSWORD=bitte-aendern

# Zufaelliges Geheimnis fuer die Login-Cookies (z.B. mit:  openssl rand -hex 32)
SESSION_SECRET=bitte-langen-zufallswert-eintragen

# Port, auf dem das Node-Backend lokal laeuft (Caddy leitet HTTPS hierher weiter)
PORT=3000

# Secure-Cookies. In Produktion (hinter HTTPS/Caddy) auf true lassen.
# Nur fuer lokales Testen ueber http://localhost auf false setzen.
COOKIE_SECURE=true

# Adresse des Python-Media-Dienstes (Whisper + Piper). Standard passt normalerweise.
MEDIA_URL=http://127.0.0.1:8001

# Arbeitsverzeichnis, in dem Claude laeuft (fuer Datei-/Code-Aufgaben). Standard: ./data
CLAUDE_WORKDIR=./data

# Claude-Modell:  "sonnet" (empfohlen) oder "opus" (klueger, langsamer) oder "haiku" (schnell)
CLAUDE_MODEL=sonnet

# ====== Media-Dienst (Python) ======
# Whisper-Modell:  small (schnell, gut) | medium (besser, langsamer) | large-v3 (am besten, braucht viel RAM/CPU)
WHISPER_MODEL=small

# Rechen-Typ fuer Whisper auf CPU:  int8 (schnell, wenig RAM) | int8_float16 | float32
WHISPER_COMPUTE=int8

# Pfad zur deutschen Piper-Stimme (wird vom Installer heruntergeladen)
PIPER_MODEL=./voices/de_DE-thorsten-medium.onnx

# Port des Python-Media-Dienstes (nur lokal)
MEDIA_PORT=8001
